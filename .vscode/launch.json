    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run blender_animate.py",
            "type": "pwa-node",
            "request": "launch",
            "runtimeExecutable": "C:\\Windows\\System32\\cmd.exe",
            "runtimeArgs": [
                "/c",
                "\"C:\\Program Files\\Blender Foundation\\Blender 5.1\\blender.exe\" --background --python \"${workspaceFolder}\\scripts\\blender_animate.py\""
